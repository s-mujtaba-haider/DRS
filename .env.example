# Copy to .env and adjust. Placeholders only - never commit real secrets.
# Backend (FastAPI)
DRS_STORAGE_DIR=./storage
DRS_MAX_UPLOAD_MB=1024
DRS_WORKER_THREADS=1
DRS_DEFAULT_DEVICE=auto
DRS_MAX_FRAMES_PER_JOB=3000
DRS_LOG_LEVEL=INFO
DRS_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
# DRS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/drs   # optional, default SQLite
# Docker host port for the backend
DRS_BACKEND_PORT=8100

# Frontend (Next.js) - put in frontend/.env.local
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8100

# Dataset downloads (optional). Prefer %USERPROFILE%\.kaggle\kaggle.json over env vars.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# ROBOFLOW_API_KEY=
